# --- Application ---
APP_NAME=Smart Campus AI
CAMPUS_NAME=PSIT Kanpur
DATA_MODE=DEMO
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# --- Database (local SQLite fallback; use Postgres in Docker/Supabase) ---
DATABASE_URL=sqlite:///./data/campus.db

# --- Supabase (optional; never put service role key in the frontend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
SIMULATOR_TOKEN=demo-simulator-token

# --- MQTT ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-campus-ai-backend
MQTT_ENABLED=true

# --- CO2 (India grid-average kg CO2e / kWh; configurable, not a campus measurement) ---
CO2_KG_PER_KWH=0.82
CO2_FACTOR_SOURCE=CEA India grid emission factor (configurable)

# --- Simulator ---
SIMULATOR_INTERVAL_SECONDS=10
SIMULATOR_API_URL=http://localhost:8000
